{
  "name": "warframe-bot",
  "version": "1.1.0",
  "description": "Warframe 信息查询与世界状态推送机器人（QQ/OneBot + KOOK）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dry-run": "tsx src/core/dry-run.ts",
    "dry-run:mock": "WARFRAMESTAT_MOCK=1 tsx src/core/dry-run.ts",
    "serve-mock-api": "node scripts/serve-mock-api.mjs",
    "test": "tsx --test tests/formatters.test.ts tests/formatters-2026.test.ts tests/dedupe.test.ts tests/locale.test.ts tests/worldstate.test.ts tests/mock.test.ts tests/de-worldstate.test.ts",
    "dev": "tsx src/index.ts",
    "fetch-lexicon": "node scripts/fetch-zh-lexicon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "warframe",
    "bot",
    "onebot",
    "kook",
    "qq"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "undici": "^7.3.0",
    "warframe-worldstate-parser": "^5.5.3",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
