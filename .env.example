# 可选：覆盖 config.yaml 中的敏感项
# ONEBOT_ACCESS_TOKEN=
# KOOK_TOKEN=
# QQ_BOT_APP_ID=
# QQ_BOT_SECRET=
# LOG_LEVEL=info

# 世界状态来源：de（推荐国内）| warframestat | mock
# WARFRAMESTAT_SOURCE=de
# WARFRAME_DE_WORLDSTATE_URL=https://api.warframe.com/cdn/worldState.php

# 国内机房 IP 被 Cloudflare 403 时，设置出网代理（优先于 config api.proxyUrl）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# WARFRAMESTAT_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# 模拟测试（无外网）：不访问外网 API，改读本地 fixture
# WARFRAMESTAT_MOCK=1
# WARFRAMESTAT_MOCK_FIXTURE=./fixtures/worldstate-pc-zh.json

# QQ 查询是否发配图（1=开；Fandom 外链易 850027，建议配 COS 后保持 1）
QQ_BOT_SEND_IMAGES=1

# --- Tencent COS 图床（推荐国内 VPS；密钥勿提交仓库）---
# 对象键前缀：warframe-bot/img/*
# 默认公网 URL：https://{COS_BUCKET}.cos.{COS_REGION}.myqcloud.com/{key}
# 示例：https://wf-1311711592.cos.ap-shanghai.myqcloud.com/warframe-bot/img/Void_Fissure.png
# 桶需对 warframe-bot/img/* 允许公有读（对象 ACL public-read，或桶策略），否则 QQ 拉图失败。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wf-1311711592
COS_REGION=ap-shanghai
# 可选 CDN / 自定义域名（无尾斜杠）；不设则用上方默认 cos.myqcloud.com
# COS_PUBLIC_BASE=https://wf-1311711592.cos.ap-shanghai.myqcloud.com
# 也可用 TENCENT_SECRET_ID / TENCENT_SECRET_KEY 代替 COS_SECRET_*
