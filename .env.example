# 可选：覆盖 config.yaml 中的敏感项
# ONEBOT_ACCESS_TOKEN=
# KOOK_TOKEN=
# LOG_LEVEL=info

# 国内机房 IP 被 Cloudflare 403 时，设置出网代理（优先于 config api.proxyUrl）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# WARFRAMESTAT_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# 模拟测试（无外网 / CF 403）：不访问 api.warframestat.us，改读本地 fixture
# WARFRAMESTAT_MOCK=1
# WARFRAMESTAT_MOCK_FIXTURE=./fixtures/worldstate-pc-zh.json
